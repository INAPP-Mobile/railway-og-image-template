# No required env vars — all params passed via query string
# PORT is auto-set by Railway

# Optional: Custom Google Fonts CSS URL (e.g. for Noto Sans)
# FONT_URL=https://fonts.googleapis.com/css2?family=Noto+Sans:wght@400;700

# Optional: Generation timeout in ms (default: 8000)
# TIMEOUT_MS=8000

# Optional: Log level (debug, info, warn, error)
# LOG_LEVEL=info
